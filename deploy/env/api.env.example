# Names/templates only. Do not load this file into the current Replit environment.
NODE_ENV=production
QXLAYER_DATABASE_PROVIDER=supabase
QXLAYER_STORAGE_PROVIDER=supabase
QXLAYER_EXTERNAL_STARTUP_APPROVED=false
QXLAYER_HEALTH_MONITOR_MODE=disabled
QXLAYER_HEALTH_MONITOR_ENABLED=false
PRODUCTION_ACCESS_GATE_ENABLED=true
DB_POOL_MAX=6
DATABASE_URL=
DB_EXPECTED_HOST=
DB_TLS_CA_FILE=/etc/secrets/supabase-ca.crt
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_PROXY_PUBLIC_URL=
SESSION_SECRET=
PRODUCTION_ACCESS_CODE=
QXLAYER_PLATFORM_URL=
QXLAYER_PLATFORM_HOSTS=
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_SERVICE_KEY=
# Only if existing Production encrypted provider envelopes need this original key:
PROVIDER_VAULT_KEY_V1=
